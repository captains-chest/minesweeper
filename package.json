{
  "name": "minesweeper",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vp test run",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint",
    "check": "vp check",
    "deploy": "pnpm run build && wrangler pages deploy dist/minesweeper/browser --project-name minesweeper --branch main",
    "preview": "pnpm run build && wrangler pages dev dist/minesweeper/browser",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  }
}
